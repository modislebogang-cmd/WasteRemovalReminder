rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // get()/exists() require a fully specified literal path, and the path must be
    // resolvable from the request alone. Staff documents are keyed by
    // "<storeCode>-<STAFFNUMBER>", which cannot be derived from an auth uid, so a
    // small mirror document keyed BY uid supplies the caller's store and role.
    function myLinkExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/staffByUid/$(request.auth.uid));
    }

    function myLink() {
      return get(/databases/$(database)/documents/staffByUid/$(request.auth.uid)).data;
    }

    function myStoreCode() {
      return myLinkExists() ? myLink().storeCode : "";
    }

    function myRole() {
      return myLinkExists() ? myLink().role : "";
    }

    // Callers may only touch data for the store on their own staff link.
    function myStore(storeCode) {
      return signedIn() && myStoreCode() == storeCode;
    }

    // Read-only access to the fixed store list (3156-Groblersdal, 3138-Jean Crossing).
    // This exists so the "All store performance" view can read every store's removal
    // history. It is deliberately narrow: the store codes are a closed set written
    // into the rules, the caller must be signed in, and only the waste history is
    // readable — products, categories, staff and activity stay private to their own
    // store. Swap in a real cross-store role here if one is ever added.
    function knownStoreCodes() {
      return ['3156', '3138'];
    }
    function isKnownStore(storeCode) {
      return signedIn() && storeCode in knownStoreCodes();
    }

    function isManager() { return myRole() == 'manager'; }

    /* ------------------------------------------------------- staffByUid ----- */
    // The uid -> store/role mirror. A signed-in user may create and refresh only
    // their own link, and may never grant themselves the manager role from here —
    // role promotion stays on the staff document, which is manager-only to update.
    match /staffByUid/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;

      // Create on first sign-in / registration. Role must match what they actually
      // hold on their staff record, which the rules read directly. The claimed
      // staffDocId must name a real staff document whose store/number agree with
      // the claim, so a user cannot link themselves to somebody else's record.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.storeCode is string
        && request.resource.data.staffNumber is string
        && request.resource.data.staffDocId == request.resource.data.storeCode + '-' + request.resource.data.staffNumber
        && get(/databases/$(database)/documents/staff/$(request.resource.data.staffDocId)).data.storeCode == request.resource.data.storeCode
        && get(/databases/$(database)/documents/staff/$(request.resource.data.staffDocId)).data.staffNumber == request.resource.data.staffNumber
        && (!('role' in request.resource.data) || request.resource.data.role in ['staff', 'manager']);

      // Refresh the link (e.g. to carry the real role forward). The claimed role
      // must always agree with the underlying staff document, so the mirror can
      // never be used to promote the caller.
      allow update: if signedIn()
        && request.auth.uid == uid
        && (!('role' in request.resource.data)
            || request.resource.data.role == get(/databases/$(database)/documents/staff/$(resource.data.staffDocId)).data.role);

      allow delete: if false;
    }

    /* -------------------------------------------------------------- staff --- */
    match /staff/{staffDocId} {
      // A staff member may read their own record (matched on the authUid field);
      // managers may read any record.
      //
      // The read must not depend on the staffByUid mirror: during the very first
      // sign-in that mirror does not exist yet, so we also accept the case where
      // the record is the caller's own store+staff-number document. Without this
      // fallback the login read is denied and the user sees
      // "You do not have permission for that action. Check your store access."
      allow read: if signedIn()
        && (
          (resource.data.authUid == request.auth.uid && resource.data.authUid != null)
          || (myLinkExists() && staffDocId == myLink().staffDocId)
          || isManager()
        );

      // A new registration may only create its own record, starting "pending" so it
      // cannot self-promote. The document id must match the store + staff number.
      allow create: if signedIn()
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.role in ['staff', 'manager'];

      // A staff member may update only their own contact/profile fields. Role, store
      // and status promotion are manager-only.
      allow update: if signedIn() && (
        (
          resource.data.authUid == request.auth.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.storeCode == resource.data.storeCode
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['displayName', 'phoneNumber', 'email', 'settings', 'authUid', 'lastLoginAt', 'status', 'updatedAt'])
          && request.resource.data.status in ['pending', 'active']
        )
        || isManager()
      );

      allow delete: if isManager();
    }

    /* ------------------------------------------------------------- stores --- */
    match /stores/{storeCode} {
      allow read: if myStore(storeCode);

      // A caller may create/refresh the store document for their own store only.
      allow create, update: if myStore(storeCode);

      match /products/{productId} {
        allow read: if myStore(storeCode);
        allow create, update: if myStore(storeCode);
        allow delete: if myStore(storeCode) && isManager();
      }

      // Removal history (requirement 6) and the analytics source (requirement 3).
      // Readable by any signed-in team member so the cross-store performance view
      // works; writes are still restricted to the caller's own store.
      match /removals/{removalId} {
        allow read: if myStore(storeCode) || isKnownStore(storeCode);
        allow create: if myStore(storeCode)
          && request.resource.data.removedBy == request.auth.uid;
        allow update, delete: if false;
      }

      match /analyticsDaily/{dayId} {
        allow read: if myStore(storeCode);
        allow create, update: if myStore(storeCode);
      }

      match /activity/{activityId} {
        allow read: if myStore(storeCode);
        allow create: if myStore(storeCode)
          && request.resource.data.userId == request.auth.uid;
        allow update, delete: if false;
      }

      match /alerts/{alertId} {
        allow read: if myStore(storeCode);
        allow create: if myStore(storeCode);
        allow update: if myStore(storeCode) && isManager();
      }

      match /members/{memberId} {
        allow read: if myStore(storeCode);
        allow create, update: if myStore(storeCode) && memberId == request.auth.uid;
      }
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}