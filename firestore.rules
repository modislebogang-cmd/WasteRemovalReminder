rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myStaffDoc() {
      return /databases/$(database)/documents/staff/$(request.auth.uid);
    }

    function myStoreCode() {
      return signedIn() && exists(myStaffDoc())
        ? get(myStaffDoc()).data.storeCode
        : "";
    }

    // Callers may only touch data for the store on their own staff record.
    function myStore(storeCode) {
      return signedIn() && myStoreCode() == storeCode;
    }

    function myRole() {
      return signedIn() && exists(myStaffDoc())
        ? get(myStaffDoc()).data.role
        : "";
    }

    function isManager() { return myRole() in ['manager', 'admin']; }
    function isAdmin() { return myRole() == 'admin'; }

    /* ------------------------------------------------------------- config --- */
    // Holds the registration setup key. Readable by any signed-in user so the client
    // can validate it during registration, but never writable from the client.
    match /config/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    /* -------------------------------------------------------------- staff --- */
    match /staff/{staffDocId} {
      // Staff may read their own record. Managers and admins may read all staff.
      allow read: if signedIn() && (resource.data.authUid == request.auth.uid || isManager());

      // A new registration may only create its own record, and it must start as
      // "pending" so it cannot self-promote to admin. The setup key is never stored.
      allow create: if signedIn()
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.role in ['staff', 'manager']
        && !request.resource.data.keys().hasAny(['setupKey']);

      // A staff member may update only their own contact/profile fields.
      // Role, store and status promotion are admin-only.
      allow update: if signedIn() && (
        (
          resource.data.authUid == request.auth.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.storeCode == resource.data.storeCode
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['displayName', 'phoneNumber', 'email', 'settings', 'authUid', 'lastLoginAt', 'status', 'updatedAt'])
        )
        || isAdmin()
      );

      allow delete: if isAdmin();
    }

    /* ------------------------------------------------------------- stores --- */
    match /stores/{storeCode} {
      allow read: if myStore(storeCode);

      // Enrolling a new member: the caller may add their own uid to memberUids.
      allow create: if signedIn()
        && request.resource.data.code == storeCode
        && request.auth.uid in request.resource.data.memberUids;

      allow update: if myStore(storeCode);

      match /products/{productId} {
        allow read: if myStore(storeCode);
        allow create, update: if myStore(storeCode);
        allow delete: if myStore(storeCode) && isManager();
      }

      // Removal history (requirement 6) and the analytics source (requirement 3).
      match /removals/{removalId} {
        allow read: if myStore(storeCode);
        allow create: if myStore(storeCode)
          && request.resource.data.removedBy == request.auth.uid;
        allow update, delete: if false;
      }

      match /analyticsDaily/{dayId} {
        allow read: if myStore(storeCode);
        // Written by the client as part of recordRemoval; increments only.
        allow create, update: if myStore(storeCode);
      }

      match /activity/{activityId} {
        allow read: if myStore(storeCode);
        allow create: if myStore(storeCode)
          && request.resource.data.userId == request.auth.uid;
        allow update, delete: if false;
      }

      match /alerts/{alertId} {
        allow read: if myStore(storeCode);
        allow create: if myStore(storeCode);
        allow update: if myStore(storeCode) && isManager();
      }

      match /members/{memberId} {
        allow read: if myStore(storeCode);
        allow create, update: if myStore(storeCode) && memberId == request.auth.uid;
      }
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
