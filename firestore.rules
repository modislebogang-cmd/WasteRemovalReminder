rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(branchId) { return signedIn() && request.auth.uid in get(/databases/$(database)/documents/branches/$(branchId)).data.memberIds; }
    match /staff/{staffId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.staffNumber == staffId;
      allow update: if signedIn() && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['settings']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authUid']) && request.resource.data.authUid == request.auth.uid
      );
    }
    match /branches/{branchId} {
      allow read: if member(branchId);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid && request.auth.uid in request.resource.data.memberIds;
      allow update: if member(branchId);
      match /products/{productId} { allow read, create, update: if member(branchId); }
      match /activity/{activityId} { allow read: if member(branchId); allow create: if member(branchId) && request.resource.data.userId == request.auth.uid; }
      match /alerts/{alertId} { allow read, create: if member(branchId); }
    }
  }
}
